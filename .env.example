# Anthropic key from a dedicated workspace with a monthly spend limit
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5. Set to claude-haiku-5-5 for a much cheaper assistant.
CLAUDE_MODEL=
# Upstash Redis. The Vercel integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead, which also work.
# Without one of these pairs, production keeps the AI switched off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: daily token budget for the whole site (default 250000). Cache reads count at a tenth.
DAILY_TOKEN_BUDGET=
# Set to 1 to switch the AI off (instant alternative: set Redis key ai:off to 1)
AI_DISABLED=
